            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Pagination metadata\", () => pm.expect(pm.response.json().meta).to.exist);"
            ]
          }
        }
      ]
    },
