    {
      "name": "07 - Check-in (Receptionist)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/appointments/{{arriveAppointmentId}}/arrive",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "appointments",
            "{{arriveAppointmentId}}",
            "arrive"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{receptionToken}}",
              "type": "string"
            }
          ]
        },
        "description": "Set arriveAppointmentId to a booked appointment at the receptionist branch, with no medical record. The ID from 04 may be used if desired."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Arrived\",()=>pm.expect(pm.response.json().data.status).to.eql(\"arrived\"));"
            ]
          }
        }
      ]
    },
